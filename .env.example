# Despliegue en GitHub Pages (el workflow las define solo; en local déjalas vacías).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=

# Destino de los leads de inscripción. El formulario hace POST (JSON como text/plain, sin preflight CORS)
# desde el navegador: Google Apps Script, Make, Zapier, n8n… Sin valor, la inscripción se cierra solo por WhatsApp.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Enlace del crédito "Desarrollado por SP Automatizaciones" en el pie de página.
NEXT_PUBLIC_DEVELOPER_URL=

# Google Analytics 4 (opcional). Se carga con lazyOnload, después de la hidratación.
NEXT_PUBLIC_GA_ID=
